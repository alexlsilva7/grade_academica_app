# Provedor prioritário: NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=
# Kimi API / Moonshot AI (https://platform.moonshot.ai/)
MOONSHOT_API_KEY=
# Opcional: substitua para fixar outro modelo Kimi no servidor.
MOONSHOT_MODEL=kimi-k2.6
# Opcional: use Gemini na extração (sem troca automática de provedor).
GEMINI_API_KEY=
# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Opcional: fornecedor restrito no OpenRouter (ex.: decart/fp4).
OPENROUTER_PROVIDER=
# Modelo padrão do servidor quando OpenRouter é o provedor disponível.
OPENROUTER_MODEL=z-ai/glm-5.2:free
# Na interface, escolha um único modelo para gerar o JSON completo.
# PDF/imagens: Moonshot, OpenRouter ou Gemini. Texto colado também aceita NVIDIA.
